<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- Pleos Vehicle SDK: Fuel·EvBattery는 CAR_ENERGY, Odometer는 CAR_DRIVE (보호 수준 normal) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- AAOS 배터리 잔량(EV_BATTERY_LEVEL). dangerous 권한이라 실행 중 요청이 필요하다 -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <!-- NaviHelper·위치·서버 통신 권한은 PLEOS-36·37·38에서 추가한다 -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!--
            주행 중(기어 D)에는 distractionOptimized를 선언하지 않은 화면을 시스템이 가린다.
            주행 기록 화면(PLEOS-45)을 주행 중에 보여 주려면 선언이 필요하다. 그 화면을 만들 때 정한다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <uses-library
            android:name="android.car"
            android:required="false" />
    </application>
</manifest>
